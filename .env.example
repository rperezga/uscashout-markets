# Copia este archivo como ".env" y rellena tus claves.
# El dashboard funciona sin las claves de IA (con fallbacks), pero SÍ necesita MongoDB.

# --- MongoDB (v2.8, OBLIGATORIA) ---
# Toda la persistencia (usuarios/sesiones/ajustes y el estado de mercado) vive en Mongo.
# El servidor NO arranca sin conexión. En local puedes usar un Mongo sin auth:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGO_DB=uscashout
# En el Kali la URI lleva credenciales (authSource=admin) — nunca subir el .env real a git.

# --- Producción ---
# NODE_ENV=production   # cookie Secure + HSTS (detrás de HTTPS)
# PORT=3000
# HOST=127.0.0.1        # bind loopback (default)


# Clave de OpenAI para el análisis IA de noticias (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Token de CryptoPanic para el feed de noticias (https://cryptopanic.com/developers/api/)
# Si falta, se usa el fallback RSS de Cointelegraph automáticamente.
CRYPTOPANIC_TOKEN=
